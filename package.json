{
  "name": "@joshbochu/pi-flash",
  "version": "0.1.4",
  "description": "Launch fresh, isolated Pi sessions in Git worktrees.",
  "type": "module",
  "license": "MIT",
  "author": "joshbochu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joshbochu/pi-flash.git"
  },
  "homepage": "https://github.com/joshbochu/pi-flash#readme",
  "bugs": {
    "url": "https://github.com/joshbochu/pi-flash/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "git",
    "worktree",
    "agent"
  ],
  "files": [
    "dist",
    "docs",
    "README.md",
    "ROADMAP.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "rolldown -c rolldown.config.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run && npm run test:handoff && npm run test:distribution",
    "test:distribution": "npm run build && node --test test/distribution.test.mjs",
    "test:handoff": "node --test test/handoff.test.mjs",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.80.6",
    "@earendil-works/pi-tui": "0.80.6",
    "@types/node": "22.19.0",
    "rolldown": "1.2.1",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
